# Copy to frontend/.env.local (never committed).

# API base. Leave empty to use /api, which `npm run dev` proxies to the local
# backend on http://127.0.0.1:8000 (override with ARTH_API_PROXY).
VITE_API_BASE_URL=
# true = answer every request from built-in sample data (no backend needed)
VITE_USE_MOCKS=true

# Google sign-in (Firebase console -> Project settings -> Your apps -> Web app).
# Public by design; sign-in turns on only when all four are set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# npm run dev only: "Sign in with Google" signs in locally without Google,
# against a backend started with ARTH_AUTH_DISABLED=true. Ignored in builds.
VITE_DEV_SIGN_IN=false
