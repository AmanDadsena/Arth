# Copy to frontend/.env.local (never committed).

# API base. Leave empty to use /api, which `npm run dev` proxies to the local
# backend on http://127.0.0.1:8000 (override with ARTH_API_PROXY).
VITE_API_BASE_URL=

# Google sign-in (Firebase console -> Project settings -> Your apps -> Web app).
# Public by design. Required: Google is the only way to sign in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
