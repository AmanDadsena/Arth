# Copy to backend/.env and fill in. Never commit .env.
ARTH_ENV=development

# Firebase project ID (Firebase console -> Project settings). Public, not a secret.
ARTH_FIREBASE_PROJECT_ID=
# Development only: accept requests without sign-in. Refused when ARTH_ENV=production.
ARTH_AUTH_DISABLED=false

# Browser origins allowed to call the API (JSON list).
ARTH_CORS_ORIGINS=["http://localhost:5173"]

# Local Gemma 4 through Ollama
ARTH_OLLAMA_URL=http://127.0.0.1:11434
ARTH_MODEL=gemma4:e2b

# Speech to text: gemma (Gemma 4's own audio input, no extra download) | whisper (faster-whisper on CPU)
ARTH_STT_BACKEND=gemma
# Only for ARTH_STT_BACKEND=whisper: tiny | base | small | medium | large-v3-turbo (downloaded on first use)
ARTH_WHISPER_MODEL=small

# 32 random bytes, base64. Leave empty in development to auto-generate .data/data.key.
# Generate: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
ARTH_DATA_KEY=

# Free key from https://data.gov.in (sign up -> My Account -> API key) for live mandi prices.
ARTH_DATA_GOV_IN_API_KEY=
# Rough truck cost used in sell advice, ₹ per quintal per km.
ARTH_TRANSPORT_RS_PER_QUINTAL_KM=2.0
